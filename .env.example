# ==============================================================================
# VARIABLES DE ENTORNO - SEBASTIAN G FOTOGRAFÍA
# ==============================================================================
# ARQUITECTURA DE DATOS:
# MongoDB Atlas es la ÚNICA fuente de verdad persistente en la nube.
# (Supabase fue retirado por completo; los esquemas históricos están en docs/legacy/).
# ==============================================================================

# BASE DE DATOS OFICIAL (FUENTE ÚNICA DE VERDAD): MONGODB ATLAS
# Obtén tu connection string en cloud.mongodb.com -> Connect -> Drivers -> Node.js
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://sebas:TU_PASSWORD_AQUI@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sebastiang

# CONFIGURACIÓN DE PROXY REVERSO (SOLO ACTIVAR EN INFRAESTRUCTURA CONFIABLE)
# En Vercel se usa x-vercel-forwarded-for automáticamente; activa TRUST_PROXY=true
# únicamente detrás de un balanceador propio controlado.
TRUST_PROXY=false

# CORREO ELECTRÓNICO (ZOHO SMTP)
# Nota: Si tienes 2FA activo en Zoho Mail, genera una "Contraseña de aplicación" (App Password)
# en Zoho Mail -> Mi Cuenta -> Seguridad -> Contraseñas de aplicaciones.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=reservas@sebastiang.app
ZOHO_SMTP_PASS=
ADMIN_EMAIL=reservas@sebastiang.app

# CANALES COMERCIALES PÚBLICOS Y LLAVES DE TRANSFERENCIA (opcional si ya están en MongoDB settings)
PHOTOGRAPHER_WHATSAPP=
PHOTOGRAPHER_WHATSAPP_2=
NEQUI_NUMBER=
DAVIPLATA_KEY=
DALE_KEY=

# SEGURIDAD Y SESIÓN ADMIN (SOPORTA ROTACIÓN DE LLAVES V1..V4)
# Obligatorio en producción: secreto aleatorio >= 32 caracteres
ADMIN_AUTH_SECRET=
ADMIN_AUTH_SECRET_KEY_ID=v1
ADMIN_AUTH_SECRET_V1=
ADMIN_AUTH_SECRET_V2=
# Opcional: keyring JSON equivalente {"v1":"<secreto_v1>","v2":"<secreto_v2>"}
ADMIN_AUTH_SECRET_KEYRING=
# Generar hash scrypt con: node scripts/hash-admin-pin.mjs "<clave-segura-min-8-caracteres>"
ADMIN_PIN_SCRYPT=
# Opcional legado (solo migración desde SHA-256; preferir siempre ADMIN_PIN_SCRYPT)
ADMIN_PIN_HASH=
# Token break-glass de un solo uso (>= 64 chars hex) para POST /api/admin/password/emergency-reset
# Generar con: node scripts/generate-emergency-token.mjs
ADMIN_EMERGENCY_RESET_TOKEN=

# NOTIFICACIONES PUSH (ONESIGNAL — REST API KEY DEBE INICIAR CON os_v2_)
ONESIGNAL_APP_ID=
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_ADMIN_EXTERNAL_ID=sebastiang_admin

# BOT DE WHATSAPP (AUTENTICACIÓN HMAC-SHA256 OBLIGATORIA EN PRODUCCIÓN)
BOT_WEBHOOK_SECRET=
WHATSAPP_BOT_WEBHOOK_SECRET=

# PASARELA WOMPI (OBLIGATORIAS SI WOMPI ESTÁ ACTIVO EN PRODUCCIÓN)
# Obtener en comercios.wompi.co -> Desarrolladores -> Llaves API y Eventos
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# CUSTODIA Y ROTACIÓN DE CLAVES DE BACKUP (AES-256-GCM CON VERSIONADO keyId)
# Define la versión activa (ej. v1, v2) y las llaves por versión para poder
# descifrar backups antiguos tras una rotación de llaves en KMS / Vercel Secret Manager.
# Debe ser estrictamente distinta a ADMIN_AUTH_SECRET.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=v1
BACKUP_ENCRYPTION_KEY_V1=
BACKUP_ENCRYPTION_KEY_V2=
# Opcionalmente en JSON: {"v1":"<secreto_v1>","v2":"<secreto_v2>"}
BACKUP_ENCRYPTION_KEYS_JSON=

# APK NATIVA ANDROID Y CONTROL DE ENTORNO
# Secreto opcional legado para /api/apk/feed (preferir tokens por dispositivo x-apk-device-token)
APK_FEED_SECRET=
# Lista separada por comas de orígenes HTTPS de preview permitidos en CORS (ej. https://preview.example.com)
ALLOWED_PREVIEW_ORIGINS=
# Habilitar galería demo en producción solo si se requiere explícitamente (false por defecto)
ALLOW_DEMO_GALLERY=false
# Proxy genérico /api/admin/db deshabilitado en producción por defecto (solo activar temporalmente si aplica)
ADMIN_DB_PROXY_ENABLED=false
# Bandera usada por scripts/run-incident-drill.mjs en pipelines productivos
CI_PRODUCTION=false

# FIRMA DE RELEASE ANDROID (CI / LOCAL — NUNCA SUBIR KEYSTORES A GIT)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# MONITOREO EXTERNO Y ALERTAS (BETTER STACK / UPTIMEROBOT / HEALTHCHECKS / SLACK / DISCORD / SENTRY)
# Endpoint de prueba mensual: POST /api/admin/monitoring/test-alert
MONITORING_WEBHOOK_URL=
SENTRY_WEBHOOK_URL=
ERROR_TRACKING_WEBHOOK_URL=
