# ==============================================================================
# VARIABLES DE ENTORNO - SEBASTIAN G FOTOGRAFÍA
# ==============================================================================
# ARQUITECTURA DE DATOS:
# MongoDB Atlas es la ÚNICA fuente de verdad persistente en la nube.
# (Supabase fue retirado por completo; los esquemas históricos están en docs/legacy/).
# ==============================================================================

# BASE DE DATOS OFICIAL (FUENTE ÚNICA DE VERDAD): MONGODB ATLAS
# Obtén tu connection string en cloud.mongodb.com -> Connect -> Drivers -> Node.js
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://sebas:TU_PASSWORD_AQUI@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sebastiang

# CONFIGURACIÓN DE PROXY REVERSO (SOLO ACTIVAR EN INFRAESTRUCTURA CONFIABLE)
# En Vercel se usa x-vercel-forwarded-for automáticamente; activa TRUST_PROXY=true
# únicamente detrás de un balanceador propio controlado.
TRUST_PROXY=false

# CORREO ELECTRÓNICO (ZOHO SMTP)
# Nota: Si tienes 2FA activo en Zoho Mail, genera una "Contraseña de aplicación" (App Password)
# en Zoho Mail -> Mi Cuenta -> Seguridad -> Contraseñas de aplicaciones.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=reservas@sebastiang.app
ZOHO_SMTP_PASS=
ADMIN_EMAIL=sgarcesg0410@gmail.com

# SEGURIDAD Y SESIÓN ADMIN
ADMIN_AUTH_SECRET=genera_un_secreto_largo_y_aleatorio_aqui
ADMIN_PIN_SCRYPT=

# NOTIFICACIONES PUSH (ONESIGNAL)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# PASARELA WOMPI (OPCIONAL)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# CUSTODIA Y ROTACIÓN DE CLAVES DE BACKUP (AES-256-GCM CON VERSIONADO keyId)
# Define la versión activa (ej. v1, v2) y las llaves por versión para poder
# descifrar backups antiguos tras una rotación de llaves en KMS / Vercel Secret Manager.
BACKUP_ENCRYPTION_KEY_ID=v1
BACKUP_ENCRYPTION_KEY_V1=
BACKUP_ENCRYPTION_KEY_V2=
# Opcionalmente en JSON: {"v1":"<secreto_v1>","v2":"<secreto_v2>"}
BACKUP_ENCRYPTION_KEYS_JSON=

# MONITOREO EXTERNO Y ALERTAS (BETTER STACK / UPTIMEROBOT / HEALTHCHECKS / SLACK / DISCORD)
# Endpoint de prueba mensual: POST /api/admin/monitoring/test-alert
MONITORING_WEBHOOK_URL=
