# ==============================================================================
# SEBASTIAN G - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a Git (ya está en .gitignore).
# ==============================================================================

# ---- SUPABASE (Base de datos y Auth) ----
# URL pública de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave anónima (pública, segura para exponer en el frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio para operaciones backend (NUNCA exponer en frontend)
SUPABASE_REST_URL=https://tu-proyecto.supabase.co
SUPABASE_REST_KEY=tu_service_role_key_aqui

# ---- ZOHO MAIL (SMTP para correos automáticos) ----
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=reservas@sebastiang.app
ZOHO_SMTP_PASS=tu_password_de_aplicacion_zoho

# ---- ONESIGNAL (Notificaciones Push 24/7) ----
ONESIGNAL_APP_ID=bc62cb00-9782-4a8e-a344-e8cf031a211a
ONESIGNAL_REST_API_KEY=os_v2_app_xxxxxxxxxxxxxxx

# ---- SEGURIDAD ADMIN ----
# Hash SHA-256 del PIN de administrador (genera uno con: node -e "console.log(require('crypto').createHash('sha256').update('TU_PIN').digest('hex'))")
ADMIN_PIN_HASH=5eb11bf58cb9eb8ad63d3dcac1e264ecda98bd97d56b4d16ea19b73d0d7584c3
# Secreto para firmar tokens de sesión admin (cualquier string aleatorio largo)
ADMIN_AUTH_SECRET=cambia_esto_por_un_string_aleatorio_largo_de_al_menos_32_caracteres
