        <domain includeSubdomains="true">sebastiang.app</domain>
        <domain includeSubdomains="true">foto-reservas.vercel.app</domain>
        <pin-set expiration="2028-01-01">
            <!-- ISRG Root X1 (Let's Encrypt / Vercel TLS Authority) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- ISRG Root X2 (Backup Pin Oficial) -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
