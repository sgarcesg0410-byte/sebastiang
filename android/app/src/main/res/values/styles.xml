<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SebastianGStudio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_gold</item>
        <item name="colorPrimaryVariant">@color/brand_dark_gold</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_amber</item>
        <item name="colorSecondaryVariant">@color/brand_dark_amber</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brand_dark_gold</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>
