{
  "name": "foto-reservas",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node start-all.js",
    "build": "vite build",
    "lint": "node scripts/check-syntax.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "ops:drill": "node scripts/run-incident-drill.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "electron": "electron .",
    "electron:build": "vite build --base=./ && electron-builder --win nsis"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "mongodb": "^7.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "dompurify": "^3.4.17",
    "undici": "^6.29.1",
    "fast-uri": "^3.1.9",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2"
  },
  "build": {
    "appId": "com.sebastiang.studio",
    "productName": "Sebastian G - Estudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sebastian G • Estudio POS",
      "uninstallDisplayName": "Sebastian G • Estudio Fotográfico"
    }
  }
}
